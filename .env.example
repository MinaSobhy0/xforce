APP_NAME=LaserBase
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://laserbase.test
APP_LOCALE=en
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laserbase
DB_USERNAME=laserbase
DB_PASSWORD=secret

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=
SESSION_DRIVER=redis
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@laserbase.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Scout/Meilisearch
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey

# Reverb WebSocket
REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Tenancy Configuration
TENANCY_QUEUE_DATABASE_CONNECTION=tenant

# Framework Configuration
LASERBASE_DEBUG=true
LASERBASE_CACHE_MODULES=true
LASERBASE_CACHE_EXTENSIONS=true

# Egyptian Market Configuration
APP_CURRENCY=EGP
APP_TAX_RATE=14.00
APP_TIMEZONE=Africa/Cairo

# Multi-tenancy specific
DB_CONNECTION_CENTRAL=pgsql
DB_CONNECTION_TENANT=tenant

# Features
TELESCOPE_ENABLED=false
HORIZON_ENABLED=true
LOG_API_REQUESTS=false
LOG_SLOW_QUERIES=true

# Development tools
ROUTE_CACHE=false
CONFIG_CACHE=false
VIEW_CACHE=false
DB_QUERY_LOG=false