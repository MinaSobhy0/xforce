{
    "name": "Treatments",
    "alias": "treatments",
    "description": "Treatment catalog and consent template management",
    "version": "1.0.0",
    "category": "operations",
    "icon": "heroicon-o-sparkles",
    "keywords": ["treatments", "services", "catalog", "consent", "pricing"],
    "priority": 15,
    "providers": [
        "Modules\\Treatments\\Providers\\TreatmentsServiceProvider"
    ],
    "dependencies": ["Core"],
    "optional_dependencies": ["Patients"],
    "models": [
        "Modules\\Treatments\\Models\\TreatmentCategory",
        "Modules\\Treatments\\Models\\Treatment",
        "Modules\\Treatments\\Models\\TreatmentBranchPricing",
        "Modules\\Treatments\\Models\\ConsentTemplate"
    ],
    "permissions": {
        "treatments.view_any": "View treatments list",
        "treatments.view": "View treatment details",
        "treatments.create": "Create new treatments",
        "treatments.update": "Update treatments",
        "treatments.delete": "Delete treatments",
        "treatments.manage_pricing": "Manage branch pricing",
        "treatment_categories.view_any": "View categories list",
        "treatment_categories.create": "Create categories",
        "treatment_categories.update": "Update categories",
        "treatment_categories.delete": "Delete categories",
        "consent_templates.view_any": "View consent templates",
        "consent_templates.create": "Create consent templates",
        "consent_templates.update": "Update consent templates",
        "consent_templates.delete": "Delete consent templates"
    },
    "default_role_permissions": {
        "admin": ["treatments.*", "treatment_categories.*", "consent_templates.*"],
        "manager": ["treatments.*", "treatment_categories.*", "consent_templates.*"],
        "doctor": ["treatments.view_any", "treatments.view", "treatment_categories.view_any", "consent_templates.view_any"],
        "nurse": ["treatments.view_any", "treatments.view", "consent_templates.view_any"],
        "receptionist": ["treatments.view_any", "treatments.view"],
        "staff": ["treatments.view_any", "treatments.view"]
    },
    "navigation": [
        {
            "id": "treatments",
            "label": {"en": "Treatments", "ar": "العلاجات"},
            "icon": "heroicon-o-sparkles",
            "route": "filament.admin.resources.treatments.index",
            "group": "operations",
            "order": 10,
            "permission": "treatments.view_any"
        },
        {
            "id": "treatment_categories",
            "label": {"en": "Categories", "ar": "الفئات"},
            "icon": "heroicon-o-folder",
            "route": "filament.admin.resources.treatment-categories.index",
            "group": "operations",
            "order": 11,
            "permission": "treatment_categories.view_any"
        },
        {
            "id": "consent_templates",
            "label": {"en": "Consent Templates", "ar": "نماذج الموافقة"},
            "icon": "heroicon-o-document-check",
            "route": "filament.admin.resources.consent-templates.index",
            "group": "operations",
            "order": 12,
            "permission": "consent_templates.view_any"
        }
    ],
    "settings": {
        "treatments.default_duration_minutes": {
            "type": "integer",
            "default": 60,
            "label": {"en": "Default treatment duration (minutes)", "ar": "مدة العلاج الافتراضية (دقائق)"}
        },
        "treatments.default_buffer_minutes": {
            "type": "integer",
            "default": 15,
            "label": {"en": "Default buffer time (minutes)", "ar": "وقت الفاصل الافتراضي (دقائق)"}
        },
        "treatments.require_consent": {
            "type": "boolean",
            "default": true,
            "label": {"en": "Require consent before treatment", "ar": "يتطلب موافقة قبل العلاج"}
        },
        "treatments.show_prices_to_patients": {
            "type": "boolean",
            "default": true,
            "label": {"en": "Show prices in patient portal", "ar": "عرض الأسعار في بوابة المريض"}
        }
    },
    "active": true
}
