{
    "name": "Loyalty",
    "alias": "loyalty",
    "description": {
        "en": "Loyalty points system with rewards, referrals, and tier management",
        "ar": "نقاط الولاء والإحالات والمكافآت"
    },
    "version": "1.0.0",
    "category": "marketing",
    "icon": "heroicon-o-star",
    "keywords": [
        "loyalty",
        "points",
        "rewards",
        "referrals",
        "tiers"
    ],
    "priority": 53,
    "providers": [
        "Modules\\Loyalty\\Providers\\LoyaltyServiceProvider",
        "Modules\\Loyalty\\Providers\\RouteServiceProvider"
    ],
    "dependencies": [
        "Core",
        "Auth",
        "Patients"
    ],
    "optional_dependencies": [
        "Billing"
    ],
    "models": [
        "Modules\\Loyalty\\Models\\LoyaltyRule",
        "Modules\\Loyalty\\Models\\LoyaltyTransaction",
        "Modules\\Loyalty\\Models\\ReferralProgram",
        "Modules\\Loyalty\\Models\\Referral"
    ],
    "permissions": {
        "loyalty_rules.view_any": "View loyalty rules",
        "loyalty_rules.view": "View loyalty rule details",
        "loyalty_rules.create": "Create loyalty rules",
        "loyalty_rules.update": "Update loyalty rules",
        "loyalty_rules.delete": "Delete loyalty rules",
        "loyalty_transactions.view_any": "View point transactions",
        "loyalty_transactions.manage": "Manage point transactions",
        "referral_programs.view_any": "View referral programs",
        "referral_programs.manage": "Manage referral programs",
        "referrals.view_any": "View referrals",
        "loyalty.reports": "View loyalty reports"
    },
    "default_role_permissions": {
        "admin": [
            "loyalty_rules.*",
            "loyalty_transactions.*",
            "referral_programs.*",
            "referrals.*",
            "loyalty.reports"
        ],
        "manager": [
            "loyalty_rules.view_any",
            "loyalty_transactions.view_any",
            "referrals.view_any",
            "loyalty.reports"
        ],
        "receptionist": [
            "loyalty_transactions.view_any",
            "referrals.view_any"
        ]
    },
    "navigation": [
        {
            "id": "loyalty_rules",
            "label": {
                "en": "Loyalty Rules",
                "ar": "قواعد الولاء"
            },
            "icon": "heroicon-o-star",
            "route": "filament.tenant.resources.loyalty-rules.index",
            "group": "marketing",
            "order": 60,
            "permission": "loyalty_rules.view_any"
        },
        {
            "id": "referral_programs",
            "label": {
                "en": "Referral Programs",
                "ar": "برامج الإحالة"
            },
            "icon": "heroicon-o-users",
            "route": "filament.tenant.resources.referral-programs.index",
            "group": "marketing",
            "order": 61,
            "permission": "referral_programs.view_any"
        }
    ],
    "settings": {
        "loyalty.points_per_currency": {
            "type": "number",
            "default": 1,
            "label": {
                "en": "Points per Currency Unit",
                "ar": "النقاط لكل وحدة عملة"
            }
        },
        "loyalty.redemption_ratio": {
            "type": "number",
            "default": 100,
            "label": {
                "en": "Points per Currency (Redemption)",
                "ar": "نقاط لكل وحدة (الاستبدال)"
            }
        }
    },
    "events": [
        "PointsEarned",
        "PointsRedeemed",
        "ReferralCreated",
        "ReferralCompleted"
    ],
    "active": true,
    "display_name": {
        "en": "Loyalty",
        "ar": "برنامج الولاء"
    }
}