            "treatment_plans.view",
            "treatment_plans.create",
            "treatment_plans.update"
        ]
    },
    "navigation": [
        {
            "id": "treatment_plans",
            "label": {
                "en": "Treatment Plans",
                "ar": "خطط العلاج"
            },
