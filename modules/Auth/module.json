                "en": "View Users List",
                "ar": "عرض قائمة المستخدمين"
            },
            "description": {
                "en": "View list of user accounts",
                "ar": "عرض قائمة حسابات المستخدمين"
            }
        },
        {
            "name": "users.view",
            "display_name": {
                "en": "View User",
                "ar": "عرض المستخدم"
            },
            "description": {
                "en": "View user account details",
                "ar": "عرض تفاصيل حساب المستخدم"
            }
        },
        {
            "name": "users.create",
            "display_name": {
                "en": "Create Users",
                "ar": "إنشاء المستخدمين"
            },
            "description": {
                "en": "Create new user accounts",
                "ar": "إنشاء حسابات مستخدمين جديدة"
            }
        },
        {
            "name": "users.update",
            "display_name": {
                "en": "Update Users",
                "ar": "تحديث المستخدمين"
            },
            "description": {
                "en": "Update user accounts",
                "ar": "تحديث حسابات المستخدمين"
            }
        },
        {
            "name": "users.delete",
            "display_name": {
                "en": "Delete Users",
                "ar": "حذف المستخدمين"
            },
            "description": {
                "en": "Delete user accounts",
                "ar": "حذف حسابات المستخدمين"
            }
        },
        {
            "name": "roles.view_any",
            "display_name": {
                "en": "View Roles List",
                "ar": "عرض قائمة الأدوار"
            },
            "description": {
                "en": "View list of user roles",
                "ar": "عرض قائمة أدوار المستخدمين"
            }
        },
        {
            "name": "roles.view",
            "display_name": {
                "en": "View Role",
                "ar": "عرض الدور"
            },
            "description": {
                "en": "View role details",
                "ar": "عرض تفاصيل الدور"
            }
        },
        {
            "name": "roles.create",
            "display_name": {
                "en": "Create Roles",
                "ar": "إنشاء الأدوار"
            },
            "description": {
                "en": "Create new user roles",
                "ar": "إنشاء أدوار مستخدمين جديدة"
            }
        },
        {
            "name": "roles.update",
            "display_name": {
                "en": "Update Roles",
                "ar": "تحديث الأدوار"
            },
            "description": {
                "en": "Update user roles",
                "ar": "تحديث أدوار المستخدمين"
            }
        },
        {
            "name": "roles.delete",
            "display_name": {
                "en": "Delete Roles",
                "ar": "حذف الأدوار"
            },
            "description": {
                "en": "Delete user roles",
                "ar": "حذف أدوار المستخدمين"
            }
        },
        {
            "name": "permissions.view_any",
            "display_name": {
                "en": "View Permissions List",
                "ar": "عرض قائمة الصلاحيات"
            },
            "description": {
                "en": "View list of system permissions",
                "ar": "عرض قائمة صلاحيات النظام"
            }
        },
        {
            "name": "permissions.view",
            "display_name": {
                "en": "View Permission",
                "ar": "عرض الصلاحية"
            },
            "description": {
                "en": "View permission details",
                "ar": "عرض تفاصيل الصلاحية"
