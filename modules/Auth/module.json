            },
            "description": {
                "en": "Assign permissions to roles",
                "ar": "تعيين الصلاحيات للأدوار"
            }
        },
        {
            "name": "users.impersonate",
            "display_name": {
                "en": "Impersonate Users",
                "ar": "انتحال شخصية المستخدمين"
            },
            "description": {
                "en": "Login as other users for support purposes",
                "ar": "تسجيل الدخول كمستخدمين آخرين لأغراض الدعم"
            }
        }
    ],
    "roles": [
        {
            "name": "owner",
            "display_name": {
                "en": "Clinic Owner",
                "ar": "مالك العيادة"
            },
            "description": {
                "en": "Clinic owner with full access to all features",
                "ar": "مالك العيادة مع الوصول الكامل لجميع الميزات"
            },
            "permissions": [
                "users.view_any",
                "users.view",
                "users.create",
                "users.update",
                "users.delete",
                "roles.view_any",
                "roles.view",
                "roles.create",
                "roles.update",
                "roles.delete",
                "permissions.view_any",
                "permissions.view",
                "permissions.assign"
            ]
        },
        {
            "name": "admin",
            "display_name": {
                "en": "Administrator",
                "ar": "مدير"
            },
            "description": {
                "en": "Tenant administrator with full access",
                "ar": "مدير المستأجر مع الوصول الكامل"
            },
            "permissions": [
                "users.view_any",
                "users.view",
                "users.create",
                "users.update",
                "users.delete",
                "roles.view_any",
                "roles.view",
                "roles.create",
                "roles.update",
                "roles.delete",
                "permissions.view_any",
                "permissions.view",
                "permissions.assign"
            ]
        },
        {
            "name": "manager",
            "display_name": {
                "en": "Manager",
                "ar": "مدير تنفيذي"
            },
            "description": {
                "en": "Department manager with limited admin access",
                "ar": "مدير القسم مع وصول إداري محدود"
            },
            "permissions": [
                "users.view_any",
                "users.view",
                "users.create",
                "users.update",
                "roles.view_any",
                "roles.view"
            ]
        },
        {
            "name": "staff",
            "display_name": {
                "en": "Staff",
                "ar": "موظف"
            },
            "description": {
                "en": "Regular staff member",
                "ar": "موظف عادي"
            },
            "permissions": [
                "users.view_any",
                "users.view"
            ]
        },
        {
            "name": "receptionist",
            "display_name": {
                "en": "Receptionist",
                "ar": "موظف استقبال"
            },
            "description": {
                "en": "Front desk receptionist",
                "ar": "موظف استقبال"
            },
            "permissions": [
                "users.view_any",
                "users.view"
            ]
        },
        {
            "name": "doctor",
            "display_name": {
                "en": "Doctor",
                "ar": "طبيب"
            },
            "description": {
                "en": "Medical doctor",
                "ar": "طبيب"
            },
            "permissions": [
                "users.view_any",
                "users.view"
            ]
        },
        {
            "name": "nurse",
            "display_name": {
                "en": "Nurse",
                "ar": "ممرض"
            },
            "description": {
                "en": "Registered nurse",
                "ar": "ممرض مسجل"
            },
            "permissions": [
                "users.view_any",
                "users.view"
            ]
        },
        {
            "name": "technician",
            "display_name": {
                "en": "Technician",
                "ar": "فني"
            },
            "description": {
                "en": "Medical technician",
                "ar": "فني طبي"
            },
