{
    "name": "Auth",
    "code": "auth",
    "version": "1.0.0",
    "description": {
        "en": "User authentication and role-based access control",
        "ar": "المستخدمين والأدوار والصلاحيات"
    },
    "author": "XLinic",
    "dependencies": [
        "core"
    ],
    "providers": [
        "Modules\\Auth\\Providers\\AuthServiceProvider"
    ],
    "aliases": [],
    "files": [
        "start.php"
    ],
    "requires": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "spatie/laravel-permission": "^6.0"
    },
    "active": true,
    "order": 2,
    "category": "system",
    "tags": [
        "auth",
        "users",
        "roles",
        "permissions"
    ],
    "permissions": [
