{
    "name": "Packages",
    "alias": "packages",
    "description": "Treatment packages with session bundles and value bundles",
    "version": "1.0.0",
    "category": "services",
    "icon": "heroicon-o-cube-transparent",
    "keywords": ["packages", "bundles", "sessions", "treatments"],
    "priority": 50,
    "providers": [
        "Modules\\Packages\\Providers\\PackagesServiceProvider",
        "Modules\\Packages\\Providers\\RouteServiceProvider"
    ],
    "dependencies": ["Core", "Auth", "Services", "Patients"],
    "optional_dependencies": ["Billing", "Booking"],
    "models": [
        "Modules\\Packages\\Models\\Package",
        "Modules\\Packages\\Models\\PackageItem",
        "Modules\\Packages\\Models\\PackageSubscription",
        "Modules\\Packages\\Models\\PackageSessionUsage"
    ],
    "permissions": {
        "packages.view_any": "View packages list",
        "packages.view": "View package details",
        "packages.create": "Create packages",
        "packages.update": "Update packages",
        "packages.delete": "Delete packages",
        "package_subscriptions.view_any": "View subscriptions",
        "package_subscriptions.view": "View subscription details",
        "package_subscriptions.create": "Create subscriptions",
        "package_subscriptions.manage": "Manage subscriptions",
        "package_sessions.use": "Use package sessions"
    },
    "default_role_permissions": {
        "admin": ["packages.*", "package_subscriptions.*", "package_sessions.*"],
        "manager": ["packages.*", "package_subscriptions.*", "package_sessions.*"],
        "doctor": ["packages.view_any", "packages.view", "package_subscriptions.view_any", "package_sessions.use"],
        "receptionist": ["packages.view_any", "packages.view", "package_subscriptions.*", "package_sessions.use"]
    },
    "navigation": [
        {
            "id": "packages",
            "label": {"en": "Packages", "ar": "الباقات"},
            "icon": "heroicon-o-cube-transparent",
            "route": "filament.tenant.resources.packages.index",
            "group": "services",
            "order": 15,
            "permission": "packages.view_any"
        }
    ],
    "settings": {
        "packages.allow_partial_usage": {
            "type": "boolean",
            "default": true,
            "label": {"en": "Allow Partial Session Usage", "ar": "السماح بالاستخدام الجزئي للجلسات"}
        },
        "packages.expiry_reminder_days": {
            "type": "integer",
            "default": 30,
            "label": {"en": "Expiry Reminder (days before)", "ar": "تذكير انتهاء الصلاحية (أيام قبل)"}
        }
    },
    "sequences": [
        {
            "code": "package_subscription",
            "prefix": "PKG-",
            "padding": 6
        }
    ],
    "events": [
        "PackageCreated",
        "PackageSubscribed",
        "PackageSessionUsed",
        "PackageExpired"
    ],
    "active": true
}
