{
    "name": "Payroll",
    "alias": "payroll",
    "description": {
        "en": "Payroll management - salary runs, structures, rules, and slips",
        "ar": "معالجة الرواتب وكشوف المرتبات"
    },
    "version": "1.0.0",
    "category": "hr",
    "icon": "heroicon-o-banknotes",
    "keywords": [
        "payroll",
        "salary",
        "hr",
        "compensation",
        "payslip"
    ],
    "priority": 55,
    "providers": [
        "Modules\\Payroll\\Providers\\PayrollServiceProvider",
        "Modules\\Payroll\\Providers\\RouteServiceProvider"
    ],
    "dependencies": [
        "Core",
        "Auth",
        "Staff"
    ],
    "optional_dependencies": [],
    "models": [
        "Modules\\Payroll\\Models\\PayrollRun",
        "Modules\\Payroll\\Models\\PayrollLine",
        "Modules\\Payroll\\Models\\SalaryRuleCategory",
        "Modules\\Payroll\\Models\\SalaryRule",
        "Modules\\Payroll\\Models\\SalaryStructure",
        "Modules\\Payroll\\Models\\EmployeeSalaryStructure",
        "Modules\\Payroll\\Models\\EmployeeSalaryComponent"
    ],
    "permissions": {
        "payroll_runs.view_any": "View payroll runs list",
        "payroll_runs.view": "View payroll run details",
        "payroll_runs.create": "Create payroll runs",
        "payroll_runs.update": "Update payroll runs",
        "payroll_runs.delete": "Delete payroll runs",
        "payroll_runs.calculate": "Calculate payroll",
        "payroll_runs.approve": "Approve payroll runs",
        "payroll_runs.pay": "Mark payroll as paid",
        "salary_structures.view_any": "View salary structures",
        "salary_structures.view": "View salary structure details",
        "salary_structures.create": "Create salary structures",
        "salary_structures.update": "Update salary structures",
        "salary_structures.delete": "Delete salary structures",
        "salary_rules.view_any": "View salary rules",
        "salary_rules.view": "View salary rule details",
        "salary_rules.create": "Create salary rules",
        "salary_rules.update": "Update salary rules",
        "salary_rules.delete": "Delete salary rules",
        "salary_categories.view_any": "View salary categories",
        "salary_categories.manage": "Manage salary categories",
        "payroll.reports": "View payroll reports"
    },
    "default_role_permissions": {
        "admin": [
            "payroll_runs.*",
            "salary_structures.*",
            "salary_rules.*",
            "salary_categories.*",
            "payroll.reports"
        ],
        "manager": [
            "payroll_runs.view_any",
            "payroll_runs.view",
            "salary_structures.view_any",
            "payroll.reports"
        ],
        "accountant": [
            "payroll_runs.*",
            "salary_structures.view_any",
            "salary_rules.view_any",
            "payroll.reports"
        ],
        "hr": [
            "payroll_runs.*",
            "salary_structures.*",
            "salary_rules.*",
            "salary_categories.*",
            "payroll.reports"
        ]
    },
    "navigation": [
        {
            "id": "payroll_runs",
            "label": {
                "en": "Payroll Runs",
                "ar": "دورات الرواتب"
            },
            "icon": "heroicon-o-banknotes",
            "route": "filament.tenant.resources.payroll-runs.index",
            "group": "hr",
            "order": 50,
            "permission": "payroll_runs.view_any"
        },
        {
            "id": "salary_structures",
            "label": {
                "en": "Salary Structures",
                "ar": "هياكل الرواتب"
            },
            "icon": "heroicon-o-rectangle-stack",
            "route": "filament.tenant.resources.salary-structures.index",
            "group": "hr",
            "order": 51,
            "permission": "salary_structures.view_any"
        },
        {
            "id": "salary_rules",
            "label": {
                "en": "Salary Rules",
                "ar": "قواعد الرواتب"
            },
            "icon": "heroicon-o-calculator",
            "route": "filament.tenant.resources.salary-rules.index",
            "group": "hr",
            "order": 52,
            "permission": "salary_rules.view_any"
        },
        {
            "id": "salary_categories",
            "label": {
                "en": "Salary Categories",
                "ar": "فئات الرواتب"
            },
            "icon": "heroicon-o-tag",
            "route": "filament.tenant.resources.salary-rule-categories.index",
            "group": "hr",
            "order": 53,
            "permission": "salary_categories.view_any"
        }
    ],
    "settings": {
        "payroll.default_pay_frequency": {
            "type": "select",
            "options": [
                "monthly",
                "bi-weekly",
                "weekly"
            ],
            "default": "monthly",
            "label": {
                "en": "Default Pay Frequency",
                "ar": "دورية الدفع الافتراضية"
            }
        },
        "payroll.social_insurance_rate": {
            "type": "number",
            "default": 11,
            "label": {
                "en": "Social Insurance Rate (%)",
                "ar": "معدل التأمين الاجتماعي (%)"
            }
        },
        "payroll.auto_calculate_tax": {
            "type": "boolean",
            "default": true,
            "label": {
                "en": "Auto Calculate Tax",
                "ar": "حساب الضريبة تلقائياً"
            }
        }
    },
    "sequences": [
        {
            "code": "payroll_run",
            "prefix": "PR-",
            "padding": 6
        }
    ],
    "events": [
        "PayrollRunCreated",
        "PayrollCalculated",
        "PayrollApproved",
        "PayrollPaid"
    ],
    "active": true,
    "display_name": {
        "en": "Payroll",
        "ar": "الرواتب"
    }
}