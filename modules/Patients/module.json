{
    "name": "Patients",
    "alias": "patients",
    "description": {
        "en": "Patient CRM and medical history management",
        "ar": "إدارة المرضى والتاريخ الطبي"
    },
    "version": "1.0.0",
    "category": "crm",
    "icon": "heroicon-o-user-group",
    "keywords": [
        "patients",
        "crm",
        "medical",
        "history",
        "consent"
    ],
    "priority": 10,
    "providers": [
        "Modules\\Patients\\Providers\\PatientsServiceProvider"
    ],
    "dependencies": [
        "Core",
        "Auth"
    ],
    "optional_dependencies": [],
    "models": [
        "Modules\\Patients\\Models\\Patient",
        "Modules\\Patients\\Models\\PatientMedicalHistory",
        "Modules\\Patients\\Models\\PatientConsentForm",
        "Modules\\Patients\\Models\\PatientPhoto",
        "Modules\\Patients\\Models\\PatientNote",
        "Modules\\Patients\\Models\\PatientAmrTest",
        "Modules\\Patients\\Models\\PatientAmrSummary"
    ],
    "permissions": {
        "patients.view_any": "View patients list",
        "patients.view": "View patient details",
        "patients.create": "Create new patients",
        "patients.update": "Update patient information",
        "patients.delete": "Delete patients",
        "patients.export": "Export patient data",
        "patients.import": "Import patient data",
        "patients.view_medical_history": "View medical history",
        "patients.edit_medical_history": "Edit medical history",
        "patients.manage_consent_forms": "Manage consent forms",
        "patients.manage_photos": "Manage patient photos",
        "patients.manage_notes": "Manage patient notes",
        "patients.view_amr": "View AMR test results",
        "patients.manage_amr": "Manage AMR test results",
        "patients.verify_amr": "Verify AMR test results"
    },
    "default_role_permissions": {
        "admin": [
            "patients.*"
        ],
        "manager": [
            "patients.*"
        ],
        "doctor": [
            "patients.view_any",
            "patients.view",
            "patients.create",
            "patients.update",
            "patients.view_medical_history",
            "patients.edit_medical_history",
            "patients.manage_consent_forms",
            "patients.manage_photos",
            "patients.manage_notes",
            "patients.view_amr",
            "patients.manage_amr",
            "patients.verify_amr"
        ],
        "nurse": [
            "patients.view_any",
            "patients.view",
            "patients.view_medical_history",
            "patients.manage_consent_forms",
            "patients.manage_photos",
            "patients.manage_notes",
            "patients.view_amr",
            "patients.manage_amr"
        ],
        "receptionist": [
            "patients.view_any",
            "patients.view",
            "patients.create",
            "patients.update"
        ],
        "staff": [
            "patients.view_any",
            "patients.view"
        ]
    },
    "navigation": [
        {
            "id": "patients",
            "label": {
                "en": "Patients",
                "ar": "المرضى"
            },
            "icon": "heroicon-o-user-group",
            "route": "filament.admin.resources.patients.index",
            "group": "crm",
            "order": 10,
            "permission": "patients.view_any"
        }
    ],
    "settings": {
        "patients.auto_generate_code": {
            "type": "boolean",
            "default": true,
            "label": {
                "en": "Auto-generate patient code",
                "ar": "توليد كود المريض تلقائياً"
            }
        },
        "patients.code_prefix": {
            "type": "string",
            "default": "PAT",
            "label": {
                "en": "Patient code prefix",
                "ar": "بادئة كود المريض"
            }
        },
        "patients.require_consent_before_treatment": {
            "type": "boolean",
            "default": true,
            "label": {
                "en": "Require consent before treatment",
                "ar": "يتطلب موافقة قبل العلاج"
            }
        },
        "patients.photo_retention_days": {
            "type": "integer",
            "default": 365,
            "label": {
                "en": "Photo retention days",
                "ar": "مدة الاحتفاظ بالصور (أيام)"
            }
        }
    },
    "sequences": {
        "patient": {
            "prefix": "PAT",
            "padding": 6,
            "pattern": "{prefix}-{YYYY}-{######}",
            "reset_on_year": true
        }
    },
    "active": true,
    "display_name": {
        "en": "Patients",
        "ar": "المرضى"
    }
}